VAULT_PATH=./evangelista-vault
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=evangelista_knowledge
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b
OLLAMA_EMBED_MODEL=nomic-embed-text
ANTHROPIC_API_KEY=sk-ant-tu_api_key_aqui
ANTHROPIC_MODEL=claude-sonnet-4-5-20251022
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768
RETRIEVAL_TOP_K=10
RETRIEVAL_FINAL_K=5
RERANKER_ENABLED=false

# RAG Configuration
RAG_RELEVANCE_THRESHOLD=0.65
RAG_TOP_K=8
RAG_HYDE_TIMEOUT_SECONDS=5
RAG_BM25_TOP_K_INTERMEDIATE=20
RAG_CLASSIFIER_CONFIDENCE_THRESHOLD=0.70

# Modelo para HyDE (puede ser diferente al modelo principal)
HYDE_MODEL=llama3.1:8b
