# Backend .env.example
# Secrets are managed in Azure Key Vault.
# Configure AZURE_KEY_VAULT_URL or specify fallback values here.

AZURE_KEY_VAULT_URL=https://<your-keyvault-name>.vault.azure.net/

# Entra ID
ENTRA_ID_TENANT_ID=<your-tenant-id>
ENTRA_ID_CLIENT_ID=<your-client-id>

# Other configs
QDRANT_MODE=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
LLM_PROVIDER=groq
